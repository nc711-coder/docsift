      "parameters": {
        "httpMethod": "POST",
        "path": "docsift",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "34fb6c03-7c0d-5361-9564-063ba9bfe3a7",
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9fa554bd-10e5-5eb0-896b-046fb46cb28e",
              "name": "review_email",
              "value": "you@example.com",
              "type": "string"
            },
            {
              "id": "3e2f7376-84bc-50bb-be49-0b6b982df34e",
              "name": "sheet_url",
              "value": "https://docs.google.com/spreadsheets/d/PASTE-YOUR-SHEET-ID/edit",
              "type": "string"
            },
            {
              "id": "55cb9ec8-88a7-580b-a070-6041fa7fe5cf",
              "name": "alert_email",
              "value": "you@example.com",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "98ba83af-2585-547a-9e00-f8c468b35aa2",
      "name": "Which event?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "39af614f-0bd3-5845-bba9-484bb4a59034",
                    "leftValue": "={{ $('DocSift events').item.json.body.event }}",
                    "rightValue": "document.approved",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Approved"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "10812c7d-2136-5d30-8fea-c68e11de9974",
                    "leftValue": "={{ $('DocSift events').item.json.body.event }}",
                    "rightValue": "document.needs_review",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Needs review"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "1b483e33-277d-5c52-9dd7-6ba578d0c71b",
                    "leftValue": "={{ $('DocSift events').item.json.body.event }}",
                    "rightValue": "docsift.error",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "Failure"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "b330ff5d-ad9f-579f-b4dd-ba5847f15781",
      "name": "Sheet row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        180
      ],
      "parameters": {
        "jsCode": "return [{ json: $('DocSift events').first().json.body.data.row }];"
      }
    },
    {
      "id": "3adc668a-6d29-52b9-a93e-a9228131b4e6",
      "name": "Add to the Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        940,
        180
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "={{ $('Settings').item.json.sheet_url }}"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "={{ $('DocSift events').item.json.body.data.sheet }}"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      }
    },
    {
      "id": "ecedfd94-87d2-5df1-98cb-0650e4051b9c",
      "name": "Review email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        700,
        420
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fe5ba808-9e2d-5253-95e1-07a36f6da36d",
              "name": "to",
              "value": "={{ $('Settings').item.json.review_email }}",
              "type": "string"
            },
            {
              "id": "ac11bd8d-d2a2-5896-a82e-93118b039ddf",
              "name": "subject",
              "value": "=Document needs a look: {{ $('DocSift events').item.json.body.data.filename }}",
              "type": "string"
            },
            {
              "id": "bd6c8313-9e7a-5eaf-a898-604ecb6aa7ae",
              "name": "text",
              "value": "=A document uploaded to DocSift needs a quick check before it's approved.\n\nFile:  {{ $('DocSift events').item.json.body.data.filename }} ({{ $('DocSift events').item.json.body.data.type }})\n\nWhy:\n{{ $('DocSift events').item.json.body.data.reasons.map(r => '- ' + r).join('\\n') }}\n\nReview and approve it here: {{ $('DocSift events').item.json.body.data.link }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "3fcd0af9-d764-5391-b4e9-c9b72bd4540f",
      "name": "Failure email",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        700,
        640
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "00b24214-cfca-5eae-aff7-c7c63dc359b6",
              "name": "to",
              "value": "={{ $('Settings').item.json.alert_email }}",
              "type": "string"
            },
            {
              "id": "2d3ad686-0d6d-5869-955b-ff2ec17262f2",
              "name": "subject",
              "value": "=DocSift failed: {{ $('DocSift events').item.json.body.data.headline }}",
              "type": "string"
            },
            {
              "id": "c7323e76-bd6c-5a95-9de9-5427129ffff4",
              "name": "text",
              "value": "=A visitor got an error instead of a result.\n\nWhat happened:  {{ $('DocSift events').item.json.body.data.headline }}\nWhen:  {{ $('DocSift events').item.json.body.data.when }}\nLikely fix:  {{ $('DocSift events').item.json.body.data.fix }}\nFile:  {{ $('DocSift events').item.json.body.data.filename || '-' }}\n{{ $('DocSift events').item.json.body.data.similar_failures_not_emailed ? 'Also ' + $('DocSift events').item.json.body.data.similar_failures_not_emailed + ' similar failure(s) since the last email.' : '' }}\n\nError:\n{{ $('DocSift events').item.json.body.data.error }}\n\nWhere:\n{{ $('DocSift events').item.json.body.data.traceback || '-' }}\n\nServer log (PowerShell):\n{{ $('DocSift events').item.json.body.data.logs_command }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "06e0bcb0-5e5f-548e-aee3-80d50dd8ff6f",
      "name": "Email the owner (failure)",
