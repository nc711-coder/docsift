# Copy to .env (never commit .env) and fill in.
GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b            # default
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b    # tried once if the main model stalls or is busy; "none" = off
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe   # only if it isn't in the default folder

# Storage: Supabase's Session pooler address (the same as Clinic Concierge; DocSift uses its own "docsift" schema).
# Without it, documents are kept in memory and lost when the app stops.
# DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# n8n: approved documents -> Google Sheet, reviews -> email (automation/README.md)
# EVENT_WEBHOOK_URL=https://n8n-XXXX.us-west1.run.app/webhook/docsift
# EVENT_WEBHOOK_SECRET=XXXX
# PUBLIC_URL=http://127.0.0.1:8000          # this app's address, for the links in review emails
